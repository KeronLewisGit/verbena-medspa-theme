{
  "name": "verbena-theme",
  "version": "1.0.0",
  "private": true,
  "description": "Build tooling for the Verbena Aesthetics WordPress theme.",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build": "tailwindcss -i ./src/app.css -o ./assets/css/app.css --minify",
